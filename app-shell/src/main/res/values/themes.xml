<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always dark with Jolpai's olive-black background, so the app never flashes white while
         it starts (the Compose screens use the same colours, see JolpaiColors.kt). -->
    <style name="Theme.Jolpai" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/jolpai_background</item>
        <item name="android:colorBackground">@color/jolpai_background</item>
        <item name="android:colorAccent">@color/jolpai_olive</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
