<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: typing history (jolpai.db) is never copied off the device, by backup or device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="jolpai.db" />
        <exclude domain="database" path="jolpai.db-shm" />
        <exclude domain="database" path="jolpai.db-wal" />
        <exclude domain="file" path="clips/" />
        <exclude domain="sharedpref" path="touch.xml" />
        <exclude domain="sharedpref" path="db_key.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="jolpai.db" />
        <exclude domain="database" path="jolpai.db-shm" />
        <exclude domain="database" path="jolpai.db-wal" />
        <exclude domain="file" path="clips/" />
        <exclude domain="sharedpref" path="touch.xml" />
        <exclude domain="sharedpref" path="db_key.xml" />
    </device-transfer>
</data-extraction-rules>
